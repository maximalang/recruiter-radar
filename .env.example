# Source runtime config. Keep values secret-safe; provider tokens belong in real env only.
# HH requires identifying app + contact email per their dev terms (https://github.com/hhru/api).
# Format: "<App>/<version> (<homepage>; <contact-email>)" — placeholder UAs are throttled or rejected.
# Example for local dev: HH_USER_AGENT=recruiter-radar-dev/1.0 (openclaw@example.com)
HH_USER_AGENT=
HH_SEARCH_TEXT=
# HH_PER_PAGE: results per page (default 20, max 100). Recommend 50 for fuller coverage.
HH_PER_PAGE=
# HH_PAGES: pages to fetch, page 0..N-1 (default 1 = only page 0; max 20).
# Set to 5 to pull pages 0..4 — more leads. Adapter auto-stops on empty page / payload.pages.
HH_PAGES=
HH_AREA=
HH_EMPLOYMENT=
HH_SCHEDULE=
HH_EXPERIENCE=
HH_PROFESSIONAL_ROLE=
HH_INDUSTRY=
HH_DATE_FROM=
HH_DATE_TO=
HH_ORDER_BY=
HH_SEARCH_FIELD=
HH_SEARCH_PARAMS_JSON=

