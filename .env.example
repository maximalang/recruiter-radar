COMPANY_NEWSROOMS_TARGETS_FILE=
COMPANY_NEWSROOMS_PROVIDER_API_URL=
COMPANY_NEWSROOMS_PROVIDER_API_TOKEN=

INDUSTRY_MEDIA_INPUT_FILE=
INDUSTRY_MEDIA_PROVIDER_API_URL=
INDUSTRY_MEDIA_PROVIDER_API_TOKEN=

