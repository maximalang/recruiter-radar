TELEGRAM_API_BASE_URL=https://api.telegram.org

RR_APP_BASE_URL=http://localhost:3000
# Required: random string ≥32 chars, used to sign rr_sid session cookies
SESSION_SECRET=
# Optional: set to "false" only for local HTTP development (disables Secure cookie flag)
SESSION_SECURE_COOKIE=
# Optional: local/dev/admin fallback owner ID — not used for public customer sessions
CHECKOUT_DEFAULT_OWNER_ID=
BILLING_WEBHOOK_SECRET=

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=change-me-local-n8n-key

# Firecrawl (self-hosted or SaaS) — structured extraction from career pages
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
FIRECRAWL_PORT=3002
# LLM provider for Firecrawl structured extraction (required)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Crawlee proxy configuration — comma-separated proxy URLs for anti-bot rotation
CRAWLEE_PROXY_URLS=

# Redis for distributed rate limiting (optional — in-memory fallback when absent)
REDIS_URL=

# Delivery channel #1 — Web Push (VAPID). Absent ⇒ web-push degrades to a no-op.
# Generate a key pair once with: npx web-push generate-vapid-keys
# WEB_PUSH_SUBJECT must be a mailto: or https: URL identifying the sender.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Delivery channel #2 — Email digest (SMTP). All five required to enable;
# absent ⇒ email digest degrades to a no-op. SMTP_PORT 465 ⇒ implicit TLS,
# 587/25 ⇒ STARTTLS. SMTP_FROM is the visible From address.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
