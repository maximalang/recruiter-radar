RR_APP_BASE_URL=http://localhost:3000
# Canonical public HTTPS origin used in one-time account login links.
AUTH_SITE_URL=http://localhost:3000
# Required: random string ≥32 chars, used to sign rr_sid session cookies
SESSION_SECRET=
# Auth Platform v2 rollout. Every switch is exact-"true" and fail-closed.
# Keep global switches false until the documented canary/preflight gate.
AUTH_PLATFORM_V2_ENABLED=false
AUTH_WORKSPACES_V2_ENABLED=false
AUTH_ONBOARDING_V2_ENABLED=false
AUTH_PASSKEYS_ENABLED=false
AUTH_LEGACY_SESSION_MIGRATION_ENABLED=false
# Optional passkey RP ID. When set, it must exactly equal the hostname in
# AUTH_SITE_URL; production passkeys require that origin to use HTTPS.
AUTH_PASSKEY_RP_ID=
# Comma-separated positive user IDs for an explicit internal canary.
AUTH_V2_CANARY_USER_IDS=
# Optional: set to "false" only for local HTTP development (disables Secure cookie flag)
SESSION_SECURE_COOKIE=
# Optional: local/dev/admin fallback owner ID — not used for public customer sessions
CHECKOUT_DEFAULT_OWNER_ID=
BILLING_WEBHOOK_SECRET=

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=change-me-local-n8n-key

# Firecrawl (self-hosted or SaaS) — AI enrichment for WEAK career pages
# (page→structured hiring signals via /v1/extract; /v1/scrape markdown fallback).
# Absent ⇒ enrichment degrades to a no-op (deterministic baseline only). Read
# from process.env.FIRECRAWL_API_KEY; never hardcoded. Cost-guarded to at most 1
# call per org per 24h. FIRECRAWL_API_URL overrides the API base (tests /
# self-hosting); defaults to http://localhost:3002 (matches the docker-compose
# service below). FIRECRAWL_PORT only governs the local docker port mapping.
#
# Architecture: Firecrawl is a TOOL/extraction layer with its own Bearer auth —
# it is NOT OpenAI-compatible and is NOT replaced by the CodeXoid/OpenAI LLM
# provider below. Firecrawl consumes OPENAI_API_KEY/OPENAI_BASE_URL/CODEXOID_MODEL
# at the container level for its OWN structured-extraction LLM calls; the LLM
# provider module below exposes the same vars to Next.js for any future in-app
# LLM call. Crawl4AI is a separate, standalone markdown-prep fallback engine.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
FIRECRAWL_PORT=3002

# Crawl4AI — markdown-prep FALLBACK for weak career pages. Used only when the
# Firecrawl extract returns empty, to prepare clean markdown for a future
# re-extraction retry. Self-hosted: set CRAWL4AI_API_URL to enable (absent ⇒
# fallback skipped). CRAWL4AI_API_TOKEN is an optional bearer for protected servers.
CRAWL4AI_API_URL=
CRAWL4AI_API_TOKEN=
# OpenAI-compatible LLM provider — the model that backs Firecrawl's structured
# extraction (and any future in-app LLM call). Defaults to OpenAI, but any
# OpenAI-compatible endpoint works: point OPENAI_BASE_URL at it and set the
# model name. CodeXoid is the configured provider here.
#
# Default OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1 (model: gpt-4o-mini)
# CodeXoid:      OPENAI_BASE_URL=https://codexoid.duckdns.org/v1
#                CODEXOID_MODEL=codexoid/kr/claude-opus-4.8
# To fall back to OpenAI, leave OPENAI_BASE_URL unset and clear CODEXOID_MODEL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://codexoid.duckdns.org/v1
# Model name passed to the LLM. When set, takes precedence over the Firecrawl
# default (gpt-4o-mini). Required for CodeXoid; leave empty for OpenAI default.
CODEXOID_MODEL=codexoid/kr/claude-opus-4.8

# Crawlee proxy configuration — comma-separated proxy URLs for anti-bot rotation
CRAWLEE_PROXY_URLS=

# Redis for distributed rate limiting + AI-enrichment per-org cost quota
# (key enrichment:{orgId}, TTL 86400s = 1 call/org/24h). Optional — without
# REDIS_URL both fall back to in-memory (single-process; dev/test only).
REDIS_URL=

# Delivery channel #1 — Web Push (VAPID). Absent ⇒ web-push degrades to a no-op.
# Generate a key pair once with: npx web-push generate-vapid-keys
# WEB_PUSH_SUBJECT must be a mailto: or https: URL identifying the sender.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Delivery channel #2 — Email digest (SMTP). All five required to enable;
# absent ⇒ email digest and auth mail degrade to a no-op. SMTP_PORT 465 ⇒
# implicit TLS, 587/25 ⇒ STARTTLS. SMTP_FROM is the visible From address;
# SMTP_REPLY_TO is optional and should use a monitored corporate mailbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
# Deterministic local/E2E outbox only. The transport refuses this mode when
# NODE_ENV=production. Use an absolute temporary path and never commit output.
# AUTH_EMAIL_TRANSPORT=test
# AUTH_EMAIL_TEST_OUTBOX_PATH=
# Opportunity Engine and Outcome Ledger stay fail-closed by default. Enable
# backend/UI only for an explicitly selected owner after the owner-scoped
# opportunity-outcomes:preflight reports ok=true and the owner-scoped
# pre-activation and process-local active canary probes both report ready=true.
OPPORTUNITY_ENGINE_V1_ENABLED=false
OPPORTUNITY_OUTCOMES_ENABLED=false
OPPORTUNITY_WORKSPACE_CONTEXT_ENABLED=false
# Commercial Signal Engine stages remain independently fail-closed. Evidence
# Radar depends on the full chain below and cannot bypass a disabled prerequisite.
COMPANY_EVENTS_V1_ENABLED=false
COMPANY_STATE_V1_ENABLED=false
SIGNAL_EPISODES_V2_ENABLED=false
COMMERCIAL_THESIS_V1_ENABLED=false
EXTERNAL_AGENCY_PROPENSITY_V1_ENABLED=false
# Phase 6 dark writer only. Keep false until the upstream propensity gate,
# tenant-scoped dry-run review, and a separate rollout decision are complete.
AGENCY_DNA_MATCH_V2_ENABLED=false
# Phase 7 shadow candidates only. This does not activate Opportunity readers,
# Today, delivery, or production rollout. Apply additionally requires one exact
# workspace and organization scope.
OPPORTUNITY_SCORING_V3_ENABLED=false
# Existing Commercial Signal surface must be enabled before Evidence Radar can
# be exposed. Evidence Radar itself remains dark under a separate rollout gate.
OPPORTUNITY_COMMERCIAL_SIGNAL_UI_ENABLED=false
EVIDENCE_RADAR_V1_ENABLED=false
# Comma-separated positive workspace IDs for a controlled Evidence Radar canary.
# Malformed, zero and negative IDs are ignored; upstream prerequisites still apply.
EVIDENCE_RADAR_V1_CANARY_WORKSPACE_IDS=
# Phase 8 profile-scoped query-plan snapshots only. The flag does not switch
# daily ingestion or readers. Apply requires one exact workspace and profile;
# unresolved geography is retained for review and never linked for execution.
QUERY_PLANNER_V2_ENABLED=false
OPPORTUNITY_OUTCOMES_UI_ENABLED=false
OPPORTUNITY_OUTCOMES_EXTERNAL_INGEST_ENABLED=false
# Daily workflow requires the workspace-scoped Opportunity Engine and Outcome
# Ledger. Keep it dark globally; the canary accepts one exact workspace ID.
OPPORTUNITY_WORKFLOW_V1_ENABLED=false
OPPORTUNITY_WORKFLOW_V1_CANARY_WORKSPACE_IDS=
OPPORTUNITY_CRM_BRIDGE_ENABLED=false
# Outcome Analytics v2 reads the append-only ledger for one authenticated
# workspace and remains dark until its separate rollout gate is approved.
OPPORTUNITY_ANALYTICS_V2_ENABLED=false
# Agency DNA remains dark globally. A single exact workspace ID may be used for
# a controlled Phase 4 canary without enabling every workspace.
AGENCY_DNA_V1_ENABLED=false
AGENCY_DNA_V1_CANARY_WORKSPACE_IDS=
# Strategist v1 requires Agency DNA in the same workspace and stays dark by
# default. The phase-specific canary accepts one exact positive workspace ID.
OPPORTUNITY_STRATEGIST_V1_ENABLED=false
OPPORTUNITY_STRATEGIST_V1_CANARY_WORKSPACE_IDS=
# One exact positive owner ID for a controlled internal canary. Any additional,
# duplicate, or malformed entry disables the canary fail-closed.
OPPORTUNITY_CANARY_OWNER_IDS=
# Separate high-entropy secret for signed generic outcome callbacks.
OPPORTUNITY_OUTCOMES_WEBHOOK_SECRET=
# Required only when a user supplies a raw contact reference. The ledger stores
# a tenant-scoped HMAC and redacted label, never the raw value.
OPPORTUNITY_OUTCOME_CONTACT_HASH_SECRET=