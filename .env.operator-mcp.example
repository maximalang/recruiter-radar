# Recruiter Radar Operator MCP — production resource-server settings
# Do not commit production values. GitHub variables/secrets are the activation source.

# The post-deploy operator workflow refuses activation unless this provider is exactly workos.
RR_OPERATOR_AUTH_PROVIDER=workos

# Keep false until AuthKit, the immutable owner subject and ChatGPT Scan Tools are ready.
RR_MCP_ENABLED=false

# Keep mutations false through initial read-only E2E acceptance.
RR_MCP_MUTATIONS_ENABLED=false

# Exact AuthKit custom/default domain issuer from /.well-known/oauth-authorization-server.
# Example only — use the exact WorkOS metadata value, including its exact path/slash form.
RR_MCP_OAUTH_ISSUER=https://<subdomain>.authkit.app

# Comma-separated immutable OAuth sub identifiers. For a single-owner MCP start with one.
RR_MCP_OAUTH_ALLOWED_SUBJECTS=user_<exact-workos-user-id>

# Written from the exact successful Deploy workflow SHA.
RR_DEPLOY_SHA=

# Intentionally absent: RR_MCP_TOKEN. Static bearer/API-key authentication is unsupported.
# Intentionally absent: WorkOS API/client secret. Recruiter Radar is only the OAuth resource server.
# The isolated operator runtime receives a host-generated read-only PostgreSQL credential instead.
