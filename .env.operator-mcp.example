# Recruiter Radar private Operator MCP — production settings
# Never commit production secrets. GitHub secrets + root-only server files are the control plane.

RR_OPERATOR_AUTH_PROVIDER=local_oidc
RR_MCP_ENABLED=false
RR_MCP_MUTATIONS_ENABLED=false

RR_MCP_OAUTH_ISSUER=https://recruiter-radar.ru/operator/oauth
RR_MCP_RESOURCE=https://recruiter-radar.ru/api/internal/mcp
RR_MCP_ALLOWED_SUBJECTS=rr_owner

# Secret: Argon2id encoded hash only, never a plaintext password.
RR_MCP_OWNER_PASSWORD_HASH=<github-secret-or-root-only-value>

# operator-auth only. In production this is generated by bootstrap with a dedicated DB role
# that can write only to the operator_auth schema.
RR_MCP_AUTH_DATABASE_URL=postgresql://rr_operator_auth:<generated-secret>@db:5432/recruiter_radar

# Persistent root/service-readable files generated on the production host.
RR_MCP_OAUTH_JWKS_FILE=/run/secrets/rr-operator-auth/jwks.json
RR_MCP_OAUTH_COOKIE_KEYS_FILE=/run/secrets/rr-operator-auth/cookie-keys.json

# Written from the exact successful Deploy workflow SHA.
RR_DEPLOY_SHA=

# Intentionally absent: static bearer tokens, WorkOS/AuthKit secrets, Better Auth provider config,
# docker.sock, arbitrary shell/SQL/fetch capabilities, or product-database write credentials.
