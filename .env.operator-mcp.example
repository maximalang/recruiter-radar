# Recruiter Radar Operator MCP — production OAuth resource-server settings
# Do not commit production values. This file documents names and safe placeholders only.

# Keep false until Auth0 API, operator subject and ChatGPT OAuth registration are ready.
RR_MCP_ENABLED=false

# Exact Auth0 issuer. Prefer the exact trailing-slash issuer shown by Auth0 discovery.
RR_MCP_OAUTH_ISSUER=https://<tenant>.<region>.auth0.com/

# Comma-separated immutable OAuth `sub` identifiers. Start with one human operator.
RR_MCP_OAUTH_ALLOWED_SUBJECTS=auth0|<exact-user-id>

# Written by the deploy workflow/runtime configurator; must be a full 40-char SHA when set.
RR_DEPLOY_SHA=

# Intentionally absent: RR_MCP_TOKEN. Static bearer/API-key authentication is unsupported.
# Intentionally absent: Auth0 client secret. Recruiter Radar is only the OAuth resource server.
