# ===========================================
# Recruiter Radar — Production Environment
# ===========================================
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to version control.
#
# Variables are grouped by section.
#   [REQUIRED]      must be filled for the app to boot
#   [REQUIRED FOR…] must be filled if you enable that source / feature
#   [OPTIONAL]      runtime tuning, safe to leave blank for defaults
#
# Full superset (with all dev/test knobs) lives in .env.example.

# ===========================================
# DATABASE [REQUIRED]
# ===========================================
POSTGRES_DB=recruiter_radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:<your-secure-password>@db:5432/recruiter_radar
DB_CONNECTION_TIMEOUT_MS=5000

# ===========================================
# APPLICATION URLS [REQUIRED]
# ===========================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
RR_APP_BASE_URL=https://your-domain.com
AUTH_SITE_URL=https://your-domain.com

# ===========================================
# MCP SECURITY GATES [SERVER-ONLY]
# ===========================================
# Legacy Recruiter Radar operational MCP stays disabled.
RR_MCP_ENABLED=false
RR_MCP_MUTATIONS_ENABLED=false
# Timeweb bridge is enabled only by the post-deploy bootstrap after protected
# GitHub Actions credentials have been staged on the production host.
RR_TIMEWEB_MCP_ENABLED=false
RR_MCP_OAUTH_ISSUER=https://recruiter-radar.ru/operator/oauth
RR_MCP_OAUTH_ALLOWED_SUBJECTS=rr_owner
# Do NOT place RR_TIMEWEB_MCP_TOKEN in this example or any NEXT_PUBLIC_* env.
# Production source of truth: GitHub Actions secret RR_TIMEWEB_MCP_TOKEN.

# ===========================================
# SESSION SECURITY [REQUIRED — generate ≥32 chars]
# ===========================================
# openssl rand -base64 32
SESSION_SECRET=<generate-32-char-secret>
SESSION_SECURE_COOKIE=true

# ===========================================
# ACCOUNT EMAIL [REQUIRED — passwordless login]
# ===========================================
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=Recruiter Radar <login@your-domain.com>

# ===========================================
# TELEGRAM [REQUIRED — delivery channel]
# ===========================================
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_BOT_USERNAME=YourBot
TELEGRAM_CHAT_ID=<your-chat-id>
TELEGRAM_WEBHOOK_SECRET=<random-secret>
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ===========================================
# DIGEST DELIVERY [REQUIRED — n8n → /api/digest/delivery]
# ===========================================
DIGEST_API_KEY=<random-key-shared-with-n8n>
DIGEST_CALLBACK_SECRET=<random-secret-for-feedback-callbacks>
DAILY_DIGEST_CLIENT_PROFILE_ID=

# ===========================================
# BILLING [REQUIRED — webhook signing]
# ===========================================
BILLING_WEBHOOK_SECRET=<your-billing-secret>

# ===========================================
# CHECKOUT [OPTIONAL — admin/dev fallback only]
# ===========================================
CHECKOUT_DEFAULT_OWNER_ID=

# ===========================================
# N8N ORCHESTRATION [REQUIRED]
# ===========================================
N8N_PORT=5678
N8N_HOST=n8n
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://n8n:5678
N8N_ENCRYPTION_KEY=<your-n8n-encryption-key>

# ===========================================
# HH.ru SOURCE [REQUIRED — primary platform source]
# ===========================================
HH_USER_AGENT=RecruiterRadar/1.0 (contact@your-domain.com)
HH_SEARCH_TEXT=
HH_PER_PAGE=100
HH_PAGES=5
HH_AREA=
HH_EMPLOYMENT=
HH_SCHEDULE=
HH_EXPERIENCE=
HH_PROFESSIONAL_ROLE=
HH_INDUSTRY=
HH_DATE_FROM=
HH_DATE_TO=
HH_ORDER_BY=
HH_SEARCH_FIELD=
HH_SEARCH_PARAMS_JSON=

# ===========================================
# CAREER PAGES [OPTIONAL — company-surface source]
# Either set TARGETS_FILE manually, or rely on auto-discovery against DATABASE_URL.
# ===========================================
CAREER_PAGES_INPUT_FILE=
CAREER_PAGES_TARGETS_FILE=
CAREER_PAGES_FETCH_OUTPUT_FILE=
CAREER_PAGES_DISCOVERY_LIMIT=
CAREER_PAGES_DISCOVERED_TARGETS_FILE=
CAREER_PAGES_DISCOVERY_REVIEW_FILE=

# ===========================================
# COMPANY SITE [OPTIONAL]
# ===========================================
COMPANY_SITE_INPUT_FILE=
COMPANY_SITE_TARGETS_FILE=

# ===========================================
# LINKEDIN [REQUIRED FOR linkedin-company-pages source]
# ===========================================
LINKEDIN_PROVIDER_API_URL=
LINKEDIN_PROVIDER_API_TOKEN=
LINKEDIN_COMPANY_PAGES_INPUT_FILE=

# ===========================================
# TECH JOB BOARDS [REQUIRED FOR tech-job-boards source]
# ===========================================
TECH_JOB_BOARDS_INPUT_FILE=
TECH_JOB_BOARDS_GREENHOUSE_TOKENS=
TECH_JOB_BOARDS_LEVER_SLUGS=
TECH_JOB_BOARDS_PROVIDER_API_URL=
TECH_JOB_BOARDS_PROVIDER_API_TOKEN=

# ===========================================
# RABOTA ROSSII [REQUIRED FOR rabota-rossii source]
# Public API: opendata.trudvsem.ru
# ===========================================
RABOTA_ROSSII_SEARCH_TEXT=
RABOTA_ROSSII_REGION_CODE=
RABOTA_ROSSII_LIMIT=50
RABOTA_ROSSII_OFFSET=
RABOTA_ROSSII_USER_AGENT=
RABOTA_ROSSII_INPUT_FILE=

# ===========================================
# SUPERJOB [REQUIRED FOR superjob source]
# ===========================================
SUPERJOB_INPUT_FILE=
SUPERJOB_PROVIDER_API_URL=
SUPERJOB_API_APP_ID=

# ===========================================
# HABR CAREER [REQUIRED FOR habr-career source]
# ===========================================
HABR_CAREER_INPUT_FILE=
HABR_CAREER_PROVIDER_API_URL=
HABR_CAREER_PROVIDER_API_TOKEN=

# ===========================================
# REGIONAL JOB BOARDS [REQUIRED FOR regional-job-boards source]
# ===========================================
REGIONAL_JOB_BOARDS_INPUT_FILE=
REGIONAL_JOB_BOARDS_PROVIDER_API_URL=
REGIONAL_JOB_BOARDS_PROVIDER_API_TOKEN=

# ===========================================
# EGRUL / FNS [REQUIRED FOR egrul-fns source]
# Russian state company registry
# ===========================================
EGRUL_FNS_INPUT_FILE=
EGRUL_FNS_INNS=
EGRUL_FNS_PUBLIC_BASE_URL=
EGRUL_FNS_PROVIDER_API_URL=
EGRUL_FNS_PROVIDER_API_TOKEN=

# ===========================================
# TRANSPARENT BUSINESS FNS [REQUIRED FOR transparent-business-fns source]
# ===========================================
TRANSPARENT_BUSINESS_FNS_INPUT_FILE=
TRANSPARENT_BUSINESS_FNS_PROVIDER_API_URL=
TRANSPARENT_BUSINESS_FNS_PROVIDER_API_TOKEN=

# ===========================================
# FEDRESURS [REQUIRED FOR fedresurs source]
# ===========================================
FEDRESURS_INPUT_FILE=
FEDRESURS_PROVIDER_API_URL=
FEDRESURS_PROVIDER_API_TOKEN=

# ===========================================
# FUNDING / BUSINESS SIGNALS [REQUIRED FOR funding-business-signals source]
# GDELT is the public default; provider URL/TOKEN override it.
# ===========================================
FUNDING_BUSINESS_SIGNALS_INPUT_FILE=
FUNDING_SIGNALS_GDELT_QUERIES=
FUNDING_SIGNALS_GDELT_QUERIES_JSON=
FUNDING_SIGNALS_GDELT_MAX_RECORDS=
FUNDING_SIGNALS_GDELT_TIMESPAN=
FUNDING_SIGNALS_GDELT_TIMEOUT_MS=
FUNDING_SIGNALS_GDELT_TRANSPORT=
FUNDING_SIGNALS_PROVIDER_API_URL=
FUNDING_SIGNALS_PROVIDER_API_TOKEN=

# ===========================================
# COMPANY NEWSROOMS [REQUIRED FOR company-newsrooms source]
# ===========================================
COMPANY_NEWSROOMS_INPUT_FILE=
COMPANY_NEWSROOMS_TARGETS_FILE=
COMPANY_NEWSROOMS_PROVIDER_API_URL=
COMPANY_NEWSROOMS_PROVIDER_API_TOKEN=

# ===========================================
# INDUSTRY MEDIA [REQUIRED FOR industry-media source]
# ===========================================
INDUSTRY_MEDIA_INPUT_FILE=
INDUSTRY_MEDIA_PROVIDER_API_URL=
INDUSTRY_MEDIA_PROVIDER_API_TOKEN=

# ===========================================
# SOURCE READINESS [OPTIONAL — verify scripts]
# ===========================================
SOURCE_READINESS_REQUIRE_LIVE_CONFIG=
SOURCE_READINESS_INCLUDE_PROVIDER_REQUIRED=
