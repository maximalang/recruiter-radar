# ===========================================
# Recruiter Radar - Production Environment
# ===========================================
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to version control!

# ===========================================
# DATABASE
# ===========================================
POSTGRES_DB=recruiter_radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:<your-secure-password>@db:5432/recruiter_radar
DB_CONNECTION_TIMEOUT_MS=5000

# ===========================================
# SOURCE CONFIGURATION
# ===========================================
HH_USER_AGENT=RecruiterRadar/1.0
HH_SEARCH_TEXT=
HH_PER_PAGE=100
HH_PAGES=5

# ===========================================
# CAREER PAGES
# ===========================================
CAREER_PAGES_INPUT_FILE=
CAREER_PAGES_TARGETS_FILE=

# ===========================================
# LINKEDIN
# ===========================================
LINKEDIN_PROVIDER_API_URL=
LINKEDIN_PROVIDER_API_TOKEN=

# ===========================================
# TELEGRAM (Required for production)
# ===========================================
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_BOT_USERNAME=YourBot
TELEGRAM_CHAT_ID=<your-chat-id>
TELEGRAM_WEBHOOK_SECRET=<random-secret>
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ===========================================
# APPLICATION URLS
# ===========================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
RR_APP_BASE_URL=https://your-domain.com

# ===========================================
# SESSION SECURITY (Required - min 32 chars)
# ===========================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=<generate-32-char-secret>
SESSION_SECURE_COOKIE=true

# ===========================================
# BILLING
# ===========================================
BILLING_WEBHOOK_SECRET=<your-billing-secret>

# ===========================================
# N8N ORCHESTRATION
# ===========================================
N8N_PORT=5678
N8N_HOST=n8n
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://n8n:5678
N8N_ENCRYPTION_KEY=<your-n8n-encryption-key>
