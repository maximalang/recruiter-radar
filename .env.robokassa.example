# Recruiter Radar — Robokassa test/live configuration.
# Copy these values to the real deployment environment. Never commit actual passwords.

# Public seller details
OPERATOR_PUBLIC_EMAIL=support@recruiter-radar.ru
OPERATOR_PUBLIC_PHONE=+7 900 966-60-92
OPERATOR_PUBLIC_POSTAL_ADDRESS=<фактический адрес для корреспонденции>

# Canonical public origins
NEXT_PUBLIC_APP_URL=https://recruiter-radar.ru
RR_APP_BASE_URL=https://recruiter-radar.ru
AUTH_SITE_URL=https://recruiter-radar.ru
PAYMENTS_SITE_URL=https://recruiter-radar.ru

# Primary provider
PAYMENTS_PROVIDER=robokassa

# Explicit environment: test during registration, live only after production verification
ROBOKASSA_MODE=test
ROBOKASSA_MERCHANT_LOGIN=<логин магазина Robokassa>
ROBOKASSA_HASH_ALGORITHM=sha256

# Test credentials from the Robokassa technical settings
ROBOKASSA_TEST_PASSWORD_1=<тестовый пароль №1>
ROBOKASSA_TEST_PASSWORD_2=<тестовый пароль №2>

# Live credentials. Leave empty until Robokassa approves the shop.
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_PASSWORD_3=
ROBOKASSA_REFUND_JWT_ALGORITHM=HS256

# Configure this exact Result URL in the Robokassa cabinet.
ROBOKASSA_RESULT_URL=https://recruiter-radar.ru/api/billing/webhook/robokassa

# NPD receipts. Set true only after connecting Robocheck SMZ / My Tax in the cabinet
# and completing a real issue + full-refund correction test.
ROBOKASSA_SMZ_RECEIPTS_ENABLED=false

# Verification evidence. Fill only after the real check was completed.
# Strict ISO 8601, for example 2026-08-04T18:30:00.000Z
ROBOKASSA_TEST_FLOW_VERIFIED_AT=
ROBOKASSA_REFUND_FLOW_VERIFIED_AT=
ROBOKASSA_NPD_RECEIPT_FLOW_VERIFIED_AT=
PDN_COMPLIANCE_VERIFIED_AT=
ROBOKASSA_LIVE_FLOW_VERIFIED_AT=

# Required application/security configuration
DATABASE_URL=
SESSION_SECRET=<случайная строка минимум 32 символа>
SESSION_SECURE_COOKIE=true
ADMIN_OPERATOR_PASSWORD=<случайный пароль оператора>
ADMIN_API_KEY=<случайный API-ключ минимум 24 символа>
CRON_API_KEY=<случайный API-ключ минимум 24 символа>

# Transactional e-mail. The visible sender/reply-to must use the public mailbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Recruiter Radar <support@recruiter-radar.ru>
SMTP_REPLY_TO=support@recruiter-radar.ru
