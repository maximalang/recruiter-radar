# Recruiter Radar — минимальная конфигурация ЮKassa и НПД.
# Скопируйте значения в production env. Секретный ключ никогда не коммитьте.

# Публичные реквизиты оператора
OPERATOR_PUBLIC_EMAIL=support@recruiter-radar.ru
OPERATOR_PUBLIC_PHONE=+7 900 966-60-92
OPERATOR_PUBLIC_POSTAL_ADDRESS=<фактический адрес для корреспонденции>

# Доступ к операторской панели и readiness API
ADMIN_OPERATOR_PASSWORD=<случайный пароль оператора>
ADMIN_API_KEY=<случайный API-ключ минимум 24 символа>
CRON_API_KEY=<случайный API-ключ минимум 24 символа>
SESSION_SECRET=<случайная строка минимум 32 символа>
SESSION_SECURE_COOKIE=true

# Канонические URL
NEXT_PUBLIC_APP_URL=https://recruiter-radar.ru
RR_APP_BASE_URL=https://recruiter-radar.ru
AUTH_SITE_URL=https://recruiter-radar.ru
PAYMENTS_SITE_URL=https://recruiter-radar.ru

# Платёжный провайдер
PAYMENTS_PROVIDER=yookassa
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=<test shopId>
YOOKASSA_SECRET_KEY=<test secret key>
YOOKASSA_WEBHOOK_URL=https://recruiter-radar.ru/api/billing/webhook/yookassa

# Заполняется после реального тестового платежа для API-проверки preflight
YOOKASSA_VERIFICATION_PAYMENT_ID=

# Заполняются только после фактического выполнения соответствующих проверок.
# Формат строго ISO 8601, например 2026-08-01T12:34:56.000Z
YOOKASSA_LAUNCH_VERIFIED_AT=
NPD_RECEIPT_FLOW_VERIFIED_AT=
PDN_COMPLIANCE_VERIFIED_AT=

# Отправка ссылок на чеки НПД клиентам — Yandex Cloud Postbox предпочтителен.
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
POSTBOX_REGION=ru-central1
POSTBOX_FROM=Recruiter Radar <support@recruiter-radar.ru>
POSTBOX_REPLY_TO=support@recruiter-radar.ru
POSTBOX_TIMEOUT_MS=10000

# Либо SMTP fallback
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Recruiter Radar <support@recruiter-radar.ru>
SMTP_REPLY_TO=support@recruiter-radar.ru

# База данных в РФ
DATABASE_URL=
DB_CONNECTION_TIMEOUT_MS=10000
