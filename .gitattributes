# Default: text auto-detect, normalize line endings on commit
* text=auto

# Shell scripts and husky hooks must keep LF on all platforms
*.sh text eol=lf
.husky/* text eol=lf

# The digest-evidence SQL is inlined into a TS String.raw mirror, which JS
# normalizes to LF at evaluation. Pin both to LF so the byte-for-byte drift
# test (digest-evidence-query.test.ts) holds on Windows working trees too.
packages/db/scripts/source-digest-evidence.sql text eol=lf
apps/web/lib/digest-evidence-query.ts text eol=lf

# Binary fixtures and assets should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
documents/** text eol=lf
manifest.json text eol=lf
