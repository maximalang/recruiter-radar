{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "jest.config.ts",
    "jest.setup.ts",
    "**/__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}