{
  "name": "Career Pages Daily Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "expression": "7" }] }
      },
      "id": "schedule-trigger",
      "name": "Daily Schedule (07:00 MSK)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "BASE_URL", "value": "={{ $env.RR_APP_BASE_URL || 'https://recruiter-radar.vercel.app' }}" },
            { "name": "INGEST_API_KEY", "value": "={{ $env.INGEST_API_KEY || $env.CRON_API_KEY }}" },
            { "name": "TELEGRAM_OPERATOR_CHANNEL_ID", "value": "={{ $env.TELEGRAM_OPERATOR_CHANNEL_ID }}" }
          ]
        }
      },
      "id": "set-env",
      "name": "Set Environment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.BASE_URL }}/api/sources/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $json.INGEST_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "source", "value": "career-pages" }
          ]
        }
      },
      "id": "http-request",
      "name": "Call Career Pages Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.success === false || $json.error || ($json.statusCode >= 400) }}", "operation": "equals", "value2": true }]
        }
      },
      "id": "check-failure",
      "name": "Check Failure",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.TELEGRAM_OPERATOR_CHANNEL_ID }}",
        "text": "=❌ Career Pages Pipeline FAILED\n\nError: {{ $json.error || $json.message || 'Unknown error' }}\nHTTP Status: {{ $json.statusCode || 'N/A' }}",
        "additionalFields": {}
      },
      "id": "telegram-alert",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $json.TELEGRAM_OPERATOR_CHANNEL_ID }}",
        "text": "=✅ Career Pages Pipeline OK\n\nSource: career-pages\nFetched: {{ $json.fetchedCount }}\nUpserted: {{ $json.upsertedCount }}",
        "additionalFields": {}
      },
      "id": "telegram-success",
      "name": "Send Telegram Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Daily Schedule (07:00 MSK)": {
      "main": [[{ "node": "Set Environment", "type": "main", "index": 0 }]]
    },
    "Set Environment": {
      "main": [[{ "node": "Call Career Pages Ingest", "type": "main", "index": 0 }]]
    },
    "Call Career Pages Ingest": {
      "main": [[{ "node": "Check Failure", "type": "main", "index": 0 }]]
    },
    "Check Failure": {
      "main": [
        [{ "node": "Send Telegram Alert", "type": "main", "index": 0 }],
        [{ "node": "Send Telegram Success", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["recruiter-radar", "daily", "career-pages"]
}
