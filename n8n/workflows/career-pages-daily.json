{
  "name": "career-pages-daily-pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 0
            },
            {
              "field": "hours",
              "hours": 7
            },
            {
              "field": "days",
              "days": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-976, 96],
      "id": "schedule-trigger",
      "name": "07:00 MSK Daily"
    },
    {
      "parameters": {
        "command": "CAREER_PAGES_TARGETS_FILE=packages/db/scripts/career-pages-smoke-targets.json npm run source:pipeline:career-pages",
        "options": {}
      },
      "type": "n8n-nodes-bash.executeCommand",
      "typeVersion": 1.2,
      "position": [-752, 96],
      "id": "run-career-pages-pipeline",
      "name": "Run Career Pages Pipeline"
    },
    {
      "parameters": {
        "mode": "manual",
        "message": "Career Pages Pipeline completed successfully"
      },
      "type": "n8n-nodes-base.notification",
      "typeVersion": 1.1,
      "position": [-528, 96],
      "id": "success-notification",
      "name": "Success Notification"
    },
    {
      "parameters": {
        "mode": "telegram",
        "options": {
          "telegram": {
            "channelId": "{{$env.TELEGRAM_OPERATOR_CHANNEL_ID}}",
            "message": "❌ Career Pages Pipeline Failed\n\nError: {{$json.error}}\n\nTime: {{$json.now}}"
          }
        }
      },
      "type": "n8n-nodes-base.notification",
      "typeVersion": 1.1,
      "position": [-528, 240],
      "id": "error-notification",
      "name": "Error Notification"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Run Career Pages Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Career Pages Pipeline": {
      "main": [
        [
          {
            "node": "Success Notification",
            "type": "main",
            "index": 0
          },
          {
            "type": "main",
            "index": 0,
            "node": "Error Notification"
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "id": "career-pages-daily-pipeline",
  "tags": ["recruiter-radar", "daily", "career-pages"]
