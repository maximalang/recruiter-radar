{
  "name": "Operational Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "operational-alert",
        "options": {},
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "x-webhook-key",
          "value": "={{ $env.OPERATIONAL_WEBHOOK_KEY }}"
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "operational-alert"
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "TELEGRAM_OPERATOR_CHANNEL_ID", "value": "={{ $env.TELEGRAM_OPERATOR_CHANNEL_ID }}" },
            { "name": "SLACK_OPERATOR_CHANNEL", "value": "={{ $env.SLACK_OPERATOR_CHANNEL }}" }
          ]
        }
      },
      "id": "set-env",
      "name": "Set Environment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [100, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.TELEGRAM_OPERATOR_CHANNEL_ID }}",
        "text": "={{ $json.message || 'Operational Alert' }}",
        "additionalFields": {}
      },
      "id": "telegram-alert",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "channel": "={{ $json.SLACK_OPERATOR_CHANNEL }}",
        "text": "={{ $json.message || 'Operational Alert' }}",
        "otherOptions": {}
      },
      "id": "slack-alert",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [450, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Set Environment", "type": "main", "index": 0 }]]
    },
    "Set Environment": {
      "main": [
        [{ "node": "Send Telegram Alert", "type": "main", "index": 0 }],
        [{ "node": "Send Slack Alert", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["recruiter-radar", "alerts", "operations"]
}
