      "position": [-528, 96],
      "id": "telegram-alert",
      "name": "Send Telegram Alert"
    },
    {
      "parameters": {
        "mode": "slack",
        "options": {
          "slack": {
            "channel": "{{$env.SLACK_OPERATOR_CHANNEL}}",
            "message": "={{ $json.message }}"
          }
        }
      },
      "type": "n8n-nodes-base.notification",
      "typeVersion": 1.1,
      "position": [-528, 240],
      "id": "slack-alert",
      "name": "Send Slack Alert"
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send Telegram Alert",
            "type": "main",
            "index": 0
          },
          {
            "type": "main",
            "index": 0,
            "node": "Send Slack Alert"
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
