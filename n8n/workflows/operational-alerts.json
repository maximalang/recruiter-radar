{
  "name": "operational-alerts",
  "nodes": [
    {
      "parameters": {
        "workflowName": "recruiter-radar-failure-alerts"
      },
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1.1,
      "position": [-976, 96],
      "id": "manual-trigger",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst message = `⚠️ Recruiter Radar Operational Alert at ${now.toISOString()}`;"
      },
      "type": "n8n-nodes-code.evaluateJavascript",
      "typeVersion": 1.1,
      "position": [-752, 96],
      "id": "prepare-message",
      "name": "Prepare Message"
    },
    {
      "parameters": {
        "mode": "telegram",
        "options": {
          "telegram": {
            "channelId": "{{$env.TELEGRAM_OPERATOR_CHANNEL_ID}}",
